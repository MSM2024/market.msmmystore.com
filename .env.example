# ZAFIRO + MSM — Environment Variables
# Copy this file to .env.local and fill in your values.

# --- SUPABASE (Auth + Database) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin credentials
ZAFIRO_ADMIN_EMAIL=admin@zafiro.app
ZAFIRO_ADMIN_PASSWORD=changeme_in_production

# --- STRIPE (Payments) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (create in Stripe Dashboard → Products)
NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=
NEXT_PUBLIC_STRIPE_PRICE_CUBA_PLUS_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_CUBA_PLUS_ANNUAL=

# --- GEMINI AI (ELIANA) ---
GEMINI_API_KEY=

# --- NEXT.JS ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
